# -----------------------------
# Repository-wide ignores
# -----------------------------

# OS / editor
.vs/
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store

# Logs
**/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# -----------------------------
# .NET build artifacts
# -----------------------------
**/bin/
**/obj/
**/TestResults/
*.user
*.suo

# EF / local SQLite runtime sidecars
*.db-shm
*.db-wal

# Local development databases
*.db
*.sqlite
*.sqlite3
*.sqlite-shm
*.sqlite-wal
*.sqlite3-shm
*.sqlite3-wal

# -----------------------------
# Frontend artifacts
# -----------------------------
**/node_modules/
**/dist/
**/dist-ssr/
**/coverage/
**/.vite/
**/test-results/
**/playwright-report/

# Vite / TS local files
**/*.tsbuildinfo
*.local
**/.env
**/.env.*
!**/.env.example
!**/.env.*.example

publish/
deploy.zip

# Azure / publish secrets
*.PublishSettings
*.pubxml

# Keys / certificates
*.pem
*.key
*.pfx
*.p12
*.cer
*.crt
id_rsa
id_dsa
id_ecdsa
id_ed25519

# Secret/config files
**/secrets.json
*credentials*.json
*service-account*.json
